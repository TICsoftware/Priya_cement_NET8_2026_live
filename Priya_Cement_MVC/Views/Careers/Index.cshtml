@using Priya_Cement_MVC.Helpers
@model Priya_Cement_BusinessLogic.Entity.CareersModel
@{
    ViewData["Title"] = Model?.Content?.ContTitle ?? "Careers";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var content = Model?.Content;
}

@section head {
    <title>@(content?.cont_window_title)</title>

    <meta content="@(content?.cont_metatag)" name="keywords" />
    <meta content="@(content?.cont_metadesc)" name="description" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="" />
    <meta name="twitter:title" content="@(content?.ContTitle)" />
    <meta name="twitter:description" content="@(content?.cont_metadesc)" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Priya Cement" />
    <meta property="og:title" content="@(content?.ContTitle)" />
    <meta property="og:description" content="@(content?.cont_metadesc)" />
    <meta property="og:url" content="@(content?.CanonicalUrl)" />
    <meta property="og:image" content="@(content?.cont_meta_image)" />

    <meta itemprop="name" content="Priya Cement" />
    <meta itemprop="description" content="@(content?.cont_metadesc)" />
    <meta itemprop="image" content="@(content?.cont_meta_image)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Priya Cement" />
    <meta property="og:title" content="@(content?.ContTitle)" />
    <meta property="og:description" content="@(content?.cont_metadesc)" />
    <meta property="og:image" content="@(content?.cont_meta_image)" />
    <meta property="og:url" content="@(content?.CanonicalUrl)" />

    <link rel="canonical" href="@(content?.CanonicalUrl)" />
}

@section Styles {
    <link rel="stylesheet" href="~/Assets/css/careers-style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/css/lifeinside-style.css" asp-append-version="true" />
}

@if (Model?.Content != null)
{
    @await Html.PartialAsync("~/Views/CommonComponent/_page_banner.cshtml", Model.Content)
}

@if (Model?.Intro_List != null && Model.Intro_List.Any())
{
    @await Html.PartialAsync("~/Views/CommonComponent/_careers_intro.cshtml", Model.Intro_List)
}

@if (Model?.LifeInside_List != null && Model.LifeInside_List.Any())
{
    @await Html.PartialAsync("~/Views/CommonComponent/_careers_life_inside.cshtml", Model.LifeInside_List)
}

@if (Model?.WorkplaceCulture_List != null && Model.WorkplaceCulture_List.Any())
{
    @await Html.PartialAsync("~/Views/CommonComponent/_careers_workplace_culture.cshtml", Model.WorkplaceCulture_List)
}

@if (Model?.Testimonials_List != null && Model.Testimonials_List.Any())
{
    @await Html.PartialAsync("~/Views/CommonComponent/_careers_testimonials.cshtml", Model.Testimonials_List)
}

@if (Model?.Careers_CTA_List != null && Model.Careers_CTA_List.Any())
{
    @await Html.PartialAsync("~/Views/CommonComponent/_careers_cta.cshtml", Model.Careers_CTA_List)
}

@section Scripts {
    <script src="~/Assets/js/inner-banner-script.js"></script>
    <script src="~/Assets/js/careers-script.js"></script>
    <script src="~/Assets/js/lifeinside-script.js" asp-append-version="true"></script>
}
