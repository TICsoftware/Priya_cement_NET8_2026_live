@using Priya_Cement_BusinessLogic.Entity
@using Priya_Cement_MVC.Helpers
@model List<ComponentModel>

@{
   var component = Model?.FirstOrDefault(x => x.IsBlock == 0)
   ?? Model?.FirstOrDefault();

   var projects = Model?
   .Where(x => x.IsBlock == 1)
   .OrderBy(x => x.Sequence)
   .ToList();
}

<section id="pageContainerLegacy" class="relative section-pt overflow-x-clip">
   <div id="connector" class="absolute inset-0 pointer-events-none z-10">
      <div id="connectorLine" class="marker-line absolute w-px bg-red-500"></div>
      <div id="connectorDot" class="absolute w-2.5 h-2.5 rounded-full bg-red-600 ring-4 ring-red-100 opacity-0"></div>
   </div>

   <!-- Copy stays on container left; media bleeds to viewport right (per design) -->
   <div class="legacy-top">
      <div class="legacy-copy">
         <div class="section-title-outer section-title-outer-start section-with-intro no-p-width">
            <h2 class="text-h2 title-section reveal-text">
               @Html.Raw(
               !string.IsNullOrWhiteSpace(component?.DisplayTitle)
               ? component.DisplayTitle.CleanParagraphTags()
               : component?.Title)
            </h2>
            @if (!string.IsNullOrWhiteSpace(component?.Intro))
            {
               <p>
                  @Html.Raw(component.Intro.CleanParagraphTags())
               </p>
            }
         </div>

         <div class="relative mt-2 md:mt-4 flex-1 slidesData-contant">
            <div class="relative select-none overflow-visible">
               <div id="bgYear" class="bg-year" aria-hidden="true"></div>
            </div>

            <span id="dotRef" class="absolute left-0 top-1 w-0 h-0"></span>
            <div id="eventContent">
               <h3 id="eventTitle"></h3>
               <p id="eventDesc"></p>
            </div>

            <div class="legacy-nav flex items-center gap-2">
               <button id="prevBtn"
                  class="nav-btn w-9 h-9 rounded-full border border-neutral-300 flex items-center justify-center text-neutral-700"
                  type="button">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round">
                     <path d="M19 12H5M12 19l-7-7 7-7" />
                  </svg>
               </button>
               <button id="nextBtn"
                  class="nav-btn w-9 h-9 rounded-full border border-neutral-300 flex items-center justify-center text-neutral-700"
                  type="button">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round">
                     <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
               </button>
            </div>
         </div>
      </div>

      <div class="legacy-media">
         <div class="legacy-media-viewport" id="legacyMediaViewport">
            <div class="legacy-media-track" id="legacyMediaTrack"></div>
         </div>
      </div>
   </div>

