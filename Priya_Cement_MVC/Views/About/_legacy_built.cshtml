   <!-- ============================================================
         TIMELINE CONTENT — edit this plain HTML to add/change slides.
         ============================================================ -->
   <div id="slidesData" class="hidden" aria-hidden="true">
      @if (projects != null)
      {
         @foreach (var item in projects.OrderBy(x => x.year))
         {
            <article data-year="@item.year">
               <img src="@(string.IsNullOrWhiteSpace(item.ThumbnailImage) 
                        ? Url.Content("~/uploads/thumbnail/dummy-rectangle-slide.webp") 
                        : item.ThumbnailImage)" alt="@item.ThumbnailAltText">
               <h3>@item.Title</h3>
               @if (!string.IsNullOrWhiteSpace(item?.Intro))
               {
                  <p>
                     @Html.Raw(item.Intro.CleanParagraphTags())
                  </p>
               }
            </article>
         }
      }
   </div>

</section>