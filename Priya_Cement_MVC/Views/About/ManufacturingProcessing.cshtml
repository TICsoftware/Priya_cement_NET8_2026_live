@using Priya_Cement_MVC.Helpers
@model Priya_Cement_BusinessLogic.Entity.AboutModel
@{
    ViewData["Title"] = Model?.Content?.ContTitle ?? "Technical Services";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var content = Model?.Content;
}

@section head {
    <title>@(content?.cont_window_title)</title>

    <meta content="@(content?.cont_metatag)" name="keywords" />
    <meta content="@(content?.cont_metadesc)" name="description" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="" />
    <meta name="twitter:title" content="@(content?.ContTitle)" />
    <meta name="twitter:description" content="@(content?.cont_metadesc)" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Priya Cement" />
    <meta property="og:title" content="@(content?.ContTitle)" />
    <meta property="og:description" content="@(content?.cont_metadesc)" />
    <meta property="og:url" content="@(content?.CanonicalUrl)" />
    <meta property="og:image" content="@(content?.cont_meta_image)" />

    <meta itemprop="name" content="Priya Cement" />
    <meta itemprop="description" content="@(content?.cont_metadesc)" />
    <meta itemprop="image" content="@(content?.cont_meta_image)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Priya Cement" />
    <meta property="og:title" content="@(content?.ContTitle)" />
    <meta property="og:description" content="@(content?.cont_metadesc)" />
    <meta property="og:image" content="@(content?.cont_meta_image)" />
    <meta property="og:url" content="@(content?.CanonicalUrl)" />

    <link rel="canonical" href="@(content?.CanonicalUrl)" />

 
}

@section Styles {
    <link rel="stylesheet" href="~/Assets/css/technicalservices-style.css" asp-append-version="true"  />
     <link rel="stylesheet" href="~/Assets/css/legacy-style.css" asp-append-version="true" />
}

@if (Model?.Content != null)
{
    @await Html.PartialAsync("~/Views/CommonComponent/_page_banner.cshtml", Model.Content)
}

@if (Model?.Intro_MP_List != null && Model.Intro_MP_List.Any())
{
    @await Html.PartialAsync("~/Views/CommonComponent/_technical_services_intro.cshtml", Model.Intro_MP_List)
}


@if (Model?.Legacy_Built_One_Year_At_A_Time_List != null && Model.Legacy_Built_One_Year_At_A_Time_List.Any())
{
    @await Html.PartialAsync("_legacy_built.cshtml", Model.Legacy_Built_One_Year_At_A_Time_List)
}

<div id="services">
    @if ((Model?.Onsite_Testing_List != null && Model.Onsite_Testing_List.Any())
        || (Model?.Testing_Capabilities_List != null && Model.Testing_Capabilities_List.Any()))
    {
        @await Html.PartialAsync("~/Views/CommonComponent/_technical_services_onsite_common_manufacturing.cshtml", Model)
    }

    @if ((Model?.Support_Intro_List != null && Model.Support_Intro_List.Any())
        || (Model?.Support_Items_List != null && Model.Support_Items_List.Any()))
    {
        @await Html.PartialAsync("~/Views/CommonComponent/_technical_services_support_manufacturing.cshtml", Model)
    }

    <div data-services-end aria-hidden="true" class="h-px w-full"></div>
</div>


@if (Model?.MP_CTA_List != null && Model.MP_CTA_List.Any())
{
    @await Html.PartialAsync("~/Views/CommonComponent/_product_cta_band.cshtml", Model.MP_CTA_List)
}



@section Scripts {
    <script src="~/Assets/js/inner-banner-script.js"></script>
    <script src="~/Assets/js/technicalservices-script.js"></script>
    <script src="~/Assets/js/table-scroll.js"></script>
    <script src="~/Assets/js/legacy-script.js" asp-append-version="true"></script>
}