@using Priya_Cement_MVC.Helpers
@model Priya_Cement_BusinessLogic.Entity.AboutModel
@{
   ViewData["Title"] = Model?.Content?.ContTitle ?? "Financial Information";
   Layout = "~/Views/Shared/_Layout.cshtml";
   var content = Model?.Content;
}

@section head {
   <title>@(content?.cont_window_title)</title>

   <meta content="@(content?.cont_metatag)" name="keywords" />
   <meta content="@(content?.cont_metadesc)" name="description" />

   <meta name="twitter:card" content="summary" />
   <meta name="twitter:site" content="" />
   <meta name="twitter:title" content="@(content?.ContTitle)" />
   <meta name="twitter:description" content="@(content?.cont_metadesc)" />

   <meta property="og:type" content="article" />
   <meta property="og:site_name" content="Priya Cement" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:url" content="@(content?.CanonicalUrl)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />

   <meta itemprop="name" content="Priya Cement" />
   <meta itemprop="description" content="@(content?.cont_metadesc)" />
   <meta itemprop="image" content="@(content?.cont_meta_image)" />

   <meta property="og:type" content="website" />
   <meta property="og:site_name" content="Priya Cement" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />
   <meta property="og:url" content="@(content?.CanonicalUrl)" />

   <link rel="canonical" href="@(content?.CanonicalUrl)" />
}


@section Styles {
   <link rel="stylesheet" href="~/Assets/css/financialinformation-style.css" asp-append-version="true" />
}

<!-- HERO BANNER END-->
@if (Model?.Content != null)
{
   @await Html.PartialAsync("~/Views/CommonComponent/_page_banner.cshtml", Model.Content)
}
<!-- HERO BANNER END -->


@foreach (var item in Model.Section_List.Where(x => Convert.ToInt32(x.Sequence) == 1))
{
   <section class="section-spacing fi-reports-section" aria-labelledby="fi-reports-heading">
      <div class="container">
         <div class="section-title-outer section-title-outer-start section-title-md section-title-left">
            <h2 class="text-h2 title-section reveal-text">
               @Html.Raw(!string.IsNullOrWhiteSpace(item.HmpgIntro)
                                   ? item.HmpgIntro.CleanParagraphTags()
                                   : item.Title)
            </h2>
         </div>

         <div class="fi-card-grid fi-report-grid">
            @foreach (var item1 in Model.SectionArticles_List.Where(x => x.ContParentId == item.ContId))
            {
               <a class="fi-report-card" href="@item1.MediafilePath" target="_blank" download
                  aria-label="Download 25th Annual Report for the year ended December 31, 2023">
                  <span class="fi-report-cover">
                     <span class="fi-report-media">
                        <img src="@(string.IsNullOrEmpty(item1.ThumbnailImage)
                                         ? "/uploads/thumbnail/annual_reports_dummy.png"
                                         : item1.ThumbnailImage)" alt="@item1.ThumbnailAltText" width="420" height="560" loading="lazy">

                        <span class="fi-report-dl" aria-hidden="true">
                           <img src="~/Assets/images/common-images/download-vector-btn-white.svg" alt="" width="15"
                                height="20">
                        </span>
                     </span>
                     <span class="fi-report-copy">
                        <strong>@item1.Title</strong>
                        <span>@item1.DisplayDate</span>
                     </span>
                  </span>
               </a>
            }
         </div>
      </div>
   </section>
}


@foreach (var item in Model.Section_List.Where(x => Convert.ToInt32(x.Sequence) == 2))
{
   <section class="section-spacing fi-mgt-section relative overflow-hidden bgimage-section"
            aria-labelledby="fi-mgt-heading">
      <div class="bgimage-outer-wrap" aria-hidden="true">
         <img src="~/Assets/images/bg-image.webp" alt="" class="w-full h-full object-cover bg-image">
      </div>

      <div class="container relative z-1">
         <div class="section-title-outer section-title-outer-start section-title-md section-title-left">
            <h2 class="text-h2 title-section reveal-text">
               @Html.Raw(!string.IsNullOrWhiteSpace(item.HmpgIntro)
                                     ? item.HmpgIntro.CleanParagraphTags()
                                     : item.Title)
            </h2>
         </div>

         <div class="fi-card-grid fi-mgt-grid">

            @foreach (var item1 in Model.SectionArticles_List.Where(x => x.ContParentId == item.ContId))
            {
               <a class="fi-mgt-card" href="@item1.MediafilePath" target="_blank" download
                  aria-label="Download Annual Return in Form MGT-7 for the financial year 2023">
                  <span class="fi-mgt-card-body">@item1.Title</span>
                  <span class="fi-mgt-card-corner" aria-hidden="true">
                     <img src="~/Assets/images/common-images/download-vector-btn-white.svg" alt="" width="15" height="20">
                  </span>
                  <span class="fi-mgt-card-hover" aria-hidden="true">
                     <span class="site-link">
                        <span class="site-link-arrow">
                           <img src="~/Assets/images/common-images/download-vector-btn-white.svg" alt="" width="15"
                                height="20">
                        </span>
                        Download
                     </span>
                  </span>
               </a>
            }
         </div>
      </div>
   </section>
}

@section Scripts {
   <script src="~/Assets/js/inner-banner-script.js" asp-append-version="true"></script>
   <script src="~/Assets/js/financialinformation-script.js" asp-append-version="true"></script>
}