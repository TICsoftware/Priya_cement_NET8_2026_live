@using Priya_Cement_MVC.Helpers
@model Priya_Cement_BusinessLogic.Entity.ESGModel
@{
   ViewData["Title"] = Model?.Content?.ContTitle ?? "Safety";
   Layout = "~/Views/Shared/_Layout.cshtml";
   var content = Model?.Content;
}

@section head {
   <title>@(content?.cont_window_title)</title>

   <meta content="@(content?.cont_metatag)" name="keywords" />
   <meta content="@(content?.cont_metadesc)" name="description" />

   <meta name="twitter:card" content="summary" />
   <meta name="twitter:site" content="" />
   <meta name="twitter:title" content="@(content?.ContTitle)" />
   <meta name="twitter:description" content="@(content?.cont_metadesc)" />

   <meta property="og:type" content="article" />
   <meta property="og:site_name" content="Priya Cement" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:url" content="@(content?.CanonicalUrl)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />

   <meta itemprop="name" content="Priya Cement" />
   <meta itemprop="description" content="@(content?.cont_metadesc)" />
   <meta itemprop="image" content="@(content?.cont_meta_image)" />

   <meta property="og:type" content="website" />
   <meta property="og:site_name" content="Priya Cement" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />
   <meta property="og:url" content="@(content?.CanonicalUrl)" />

   <link rel="canonical" href="@(content?.CanonicalUrl)" />

   @if (!string.IsNullOrWhiteSpace(content?.page_schema))
   {
      @Html.Raw(content?.page_schema.Replace("<p>", "").Replace("</p>", ""))
   }
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/sustainability-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/solutions-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/products-inside-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/aboutus-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/legacy-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/technicalservices-style.css" asp-append-version="true" />
}

<!-- HERO BANNER END-->

@if (Model?.Content != null)
{
   @await Html.PartialAsync("~/Views/CommonComponent/_page_banner.cshtml", Model.Content)
}

@if (Model?.Intro_List != null && Model.Intro_List.Any())
{
   @await Html.PartialAsync("~/Views/CommonComponent/_careers_intro.cshtml", Model.Intro_List)
}

<div id="services">
   @if ((Model?.Our_safety_culture_in_practice_List != null && Model.Our_safety_culture_in_practice_List.Any()))
   {
      @await Html.PartialAsync("~/Views/CommonComponent/_technical_services_onsite_safety.cshtml", Model)
   }
   <div data-services-end aria-hidden="true" class="h-px w-full"></div>
</div>


@if (Model?.Recognising_the_people_who_make_us_safer_List != null &&
Model.Recognising_the_people_who_make_us_safer_List.Any())
{
   @await Html.PartialAsync("_what_we_stand.cshtml", Model.Recognising_the_people_who_make_us_safer_List)
}


@if (Model?.Safety_infrastructure_and_systems_List != null && Model.Safety_infrastructure_and_systems_List.Any())
{
   @await Html.PartialAsync("~/Views/CommonComponent/_product_intro_bestfor.cshtml",Model.Safety_infrastructure_and_systems_List)
}

@if (Model?.Competency_is_the_foundation_of_safe_operations_List != null &&
Model.Competency_is_the_foundation_of_safe_operations_List.Any())
{
   @await Html.PartialAsync("_what_we_stand_no_icon_image.cshtml",Model.Competency_is_the_foundation_of_safe_operations_List)
}



<section class="section-spacing whypartner-section relative overflow-hidden">
    <div class="container relative z-1">
        <div class="whypartner-split">
            @if (Model?.Safety_governance_and_participation_List != null && Model.Safety_governance_and_participation_List.Any())
            {
                foreach (var item in Model.Safety_governance_and_participation_List.Where(x => x.IsBlock == 0))
                {
                    <div class="whypartner-apply">
                        <div class="section-title-outer section-title-outer-start section-title-md">
                            <h2 class="text-h2 title-section reveal-text">
                                @Html.Raw(!string.IsNullOrWhiteSpace(item.DisplayTitle)
                                                        ? item.DisplayTitle.CleanParagraphTags()
                                                        : item.Title)
                            </h2>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Intro))
                        {
                            @Html.Raw(item.Intro.CleanParagraphTags())
                        }
                    </div>
                }
            }

            @if (Model?.Committee_activities_List != null && Model.Committee_activities_List.Any())
            {
                foreach (var item in Model.Committee_activities_List.Where(x => x.IsBlock == 0))
                {
                    <div class="whypartner-need">
                        <div class="section-title-outer section-title-outer-start section-title-md">
                            <h2 class="text-h2 title-section reveal-text">
                                @Html.Raw(!string.IsNullOrWhiteSpace(item.DisplayTitle)
                                                        ? item.DisplayTitle.CleanParagraphTags()
                                                        : item.Title)
                            </h2>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Intro))
                        {
                            @Html.Raw(item.Intro)
                        }
                    </div>
                }
            }

        </div>
    </div>
</section>


