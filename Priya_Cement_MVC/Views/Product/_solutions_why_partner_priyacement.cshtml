@using Priya_Cement_BusinessLogic.Entity
@using Priya_Cement_MVC.Helpers
@model List<ComponentModel>

@{
    var component = Model?.FirstOrDefault(x => x.IsBlock == 0) ?? Model?.FirstOrDefault();

}

<section class="section-spacing whypartner-section relative overflow-hidden" aria-labelledby="whypartner-heading">
    <div class="bgimage-outer-wrap" aria-hidden="true">
        <img src="~/Assets/images/bg-image-dark.webp" alt="" class="w-full h-full object-cover bg-image">
    </div>
    <div class="container relative z-1">
        <div class="section-title-outer section-title-outer-start solutions-faq-heading">
            <h2 class="text-h2 title-section reveal-text">
                @Html.Raw(!string.IsNullOrWhiteSpace(component.DisplayTitle)
                                ? component.DisplayTitle.CleanParagraphTags()
                                : component.Title)
            </h2>
        </div>

        <div class="whypartner-grid">

            @foreach (var item in Model.Where(x => x.IsBlock == 1)
                        .OrderBy(x => x.Sequence))
            {
                <article class="whypartner-card">
                    <div class="whypartner-card-head">
                        <h3 class="whypartner-card-title">
                            @item.Title
                        </h3>
                        <span class="whypartner-card-num text-ghost text-big leading-none font-bold" aria-hidden="true">
                            @item.Sequence.ToString("D2")
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.Intro))
                    {
                        <p>
                            @Html.Raw(item.Intro.CleanParagraphTags())
                        </p>
                    }
                </article>
            }
        </div>
    </div>
</section>