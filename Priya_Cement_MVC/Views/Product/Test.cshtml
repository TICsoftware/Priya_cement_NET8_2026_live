@using Priya_Cement_MVC.Helpers
@model Priya_Cement_BusinessLogic.Entity.ProductModel
@{
   ViewData["Title"] = "Product";
   Layout = "~/Views/Shared/_Layout.cshtml";
}

@section head {
   <title>@Model.Content.cont_window_title</title>

   <meta content="@Model.Content.cont_metatag" name="keywords" />
   <meta content="@Model.Content.cont_metadesc" name="description" />


   <meta name="twitter:card" content="summary" />
   <meta name="twitter:site" content="" />
   <meta name="twitter:title" content="@Model.Content.ContTitle" />
   <meta name="twitter:description" content="@Model.Content.cont_metadesc" />


   <meta property="og:type" content="article" />
   <meta property="og:site_name" content="Priya Cement" />
   <meta property="og:title" content="@Model.Content.ContTitle" />
   <meta property="og:description" content="@Model.Content.cont_metadesc" />
   <meta property="og:url" content="https://www.priyacement.com/" />
   <meta property="og:image" content="@Model.Content.cont_meta_image" />

   <meta itemprop="name" content="Priya Cement" />
   <meta itemprop="description" content="@Model.Content.cont_metadesc" />
   <meta itemprop="image" content="@Model.Content.cont_meta_image" />

   <!-- Facebook / Open Graph -->
   <meta property="og:type" content="website" />
   <meta property="og:site_name" content="Priya Cement" />
   <meta property="og:title" content="@Model.Content.ContTitle" />
   <meta property="og:description" content="@Model.Content.cont_metadesc" />
   <meta property="og:image" content="@Model.Content.cont_meta_image" />
   <meta property="og:url" content="https://www.priyacement.com/" />

   <link rel="canonical" href="@Model.Content.CanonicalUrl" />
}


@section Styles {
   <link rel="stylesheet" href="~/Assets/css/technicalservices-style.css" />
}



<!-- HERO BANNER END-->
<section class="relative inside-banner-outer overflow-hidden">
   <div class="inside-banner-inner banner-animation relative ">

      <!-- Banner -->
      <div class="overflow-hidden h-[75vh] sm:h-131.25 relative innerbanner-image-wrapper">

         <!-- Parallax Image -->
         <picture>
            <!-- Desktop -->
            <source media="(min-width:1024px)" srcset="~/Assets/images/banners/technicalservices-banner-desktop.webp">

            <!-- Tablet -->
            <source media="(min-width:992px)" srcset="~/Assets/images/banners/technicalservices-banner-mob.webp">

            <!-- Mobile -->
            <img src="~/Assets/images/banners/technicalservices-banner-mob.webp" alt="About Bubble Food"
               class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover" loading="eager"
               fetchpriority="high">
         </picture>

         <!-- Keep Existing Overlay -->
         <div class="innerbanner-overlay"></div>


      </div>

      <!-- Content -->

      <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
         <div class="container">
            <div class="max-w-4xl text-left">

               <h1 class="innerbanner-title text-h1 text-white">
                  Technical Services (MTV)
               </h1>

               <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                  <ol class="flex items-center gap-2 text-sm">
                     <li>
                        <a href="/" class="text-white/70 hover:text-white transition">
                           Home
                        </a>
                     </li>
                     <li class="text-white/60">/</li>
                     <li>
                        <a href="/" class="text-white/70 hover:text-white transition">
                           Products
                        </a>
                     </li>
                     <li class="text-white/60">/</li>
                     <li class="text-white">
                        Technical Services (MTV)
                     </li>
                  </ol>
               </nav>

            </div>
         </div>
      </div>


   </div>
</section>
<!-- HERO BANNER END -->

<section class="technicalservices-intro section-spacing page-intro-outer">
   <div class="container">
      <div
         class="technicalservices-intro-row flex flex-col-reverse lg:flex-row lg:items-center gap-8 lg:gap-8 xl:gap-12">
         <div class="intro-outer-wrapper technicalservices-intro-copy lg:max-w-[40%]">


            <div class="section-title-outer section-title-outer-start section-with-intro">
               <h2 class="text-h2 title-section reveal-text">
                  Expert support, <span>right where you need it</span>
               </h2>
               <p>Building well requires more than good cement. It requires the right knowledge, the right tests and the
                  right guidance at every stage of construction. Priya Cement's Technical Services (MTV) brings both
                  directly to your site, through on-site material testing and hands-on construction advisory from a team
                  of qualified technical engineers.</p>
            </div>

            <!-- tabs live in intro; JS docks them fixed while scrolling services -->
            <div data-tab-anchor class="mt-6 sm:mt-6 lg:mt-8">
               <div data-tab-wrap class="z-40 w-full">
                  <div class="-mx-4 overflow-x-auto px-4 no-scrollbar sm:mx-0 sm:px-0">
                     <div id="tabbar" role="tablist" aria-label="Technical services"
                        class="relative inline-flex w-max min-w-full rounded-full border border-border bg-white p-0.5 transition-all duration-300 sm:w-auto sm:min-w-0 sm:p-1.5">
                        <span id="tabpill" aria-hidden="true"
                           class="pointer-events-none absolute left-0 top-0 rounded-full bg-secondary"></span>
                        <button type="button" role="tab" data-tab="onsite" aria-selected="true"
                           class="tab relative z-10 flex-1 whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-semibold transition-colors duration-300 sm:flex-none sm:px-7 sm:py-3 sm:text-base">Testing
                           services</button>
                        <button type="button" role="tab" data-tab="support" aria-selected="false"
                           class="tab relative z-10 flex-1 whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-semibold transition-colors duration-300 sm:flex-none sm:px-7 sm:py-3 sm:text-base">Technical
                           support services</button>
                     </div>
                  </div>
               </div>
            </div>

         </div>
         <div class="technicalservices-intro-media rounded-md parallax-wrap lg:max-w-[60%]">
            <img src="~/Assets/images/products/expert-support.webp" alt=""
               class="rounded-md object-cover shadow-card parallax-img" />
         </div>
      </div>
   </div>
</section>

<div id="services">

   <!-- ON-SITE -->
   <section id="onsite" class="scroll-mt-28 lg:scroll-mt-40 section-spacing">
      <div class="container">
         <div class="flex flex-col lg:flex-row lg:items-start gap-6 lg:gap-10">
            <div class="rounded-md parallax-wrap lg:max-w-[60%] w-full">
               <img src="~/Assets/images/products/professional.webp" alt=""
                  class="rounded-md object-cover shadow-card parallax-img" />
            </div>
            <div class="lg:max-w-[45%]" data-fade>
               <div class="section-title-outer section-title-outer-start section-with-intro section-title-nonintro">
                  <span class="eyebrow-text">On-site testing services</span>
                  <h2 class="text-h2 title-section reveal-text">
                     <span>Professional testing facilities</span> delivered to your site
                  </h2>
                  <p>Waiting on a laboratory report should never slow down a construction project. Priya Cement's
                     On-Site Testing Service brings a fully equipped mobile testing facility directly to your site,
                     delivering rapid material quality verification, early issue detection and expert interpretation
                     without disrupting your schedule.</p>
               </div>
               <h3 class="mt-10 text-h4">What this service means for your project:</h3>

               <ul class="mt-6 grid gap-5 grid-cols-2 sm:grid-cols-2 onsite-ul">
                  <li class="flex items-center gap-2 sm:gap-4 onsite-ul-list">
                     <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-surface-strong">
                        <img src="~/Assets/images/products/bestfor/high-rise-buildings.svg" alt=""
                           class="h-auto w-auto object-cover shrink-0">
                     </span>
                     <span class="text-20 font-medium">Quality assurance</span>
                  </li>
                  <li class="flex items-center gap-2 sm:gap-4 onsite-ul-list">
                     <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-surface-strong">
                        <img src="~/Assets/images/products/bestfor/high-rise-buildings.svg" alt=""
                           class="h-auto w-auto object-cover shrink-0">
                     </span>
                     <span class="text-20 font-medium">Rapid results</span>
                  </li>
                  <li class="flex items-center gap-2 sm:gap-4 onsite-ul-list">
                     <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-surface-strong">
                        <img src="~/Assets/images/products/bestfor/high-rise-buildings.svg" alt=""
                           class="h-auto w-auto object-cover shrink-0">
                     </span>
                     <span class="text-20 font-medium">Early issue detection</span>
                  </li>
                  <li class="flex items-center gap-2 sm:gap-4 onsite-ul-list">
                     <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-surface-strong">
                        <img src="~/Assets/images/products/bestfor/high-rise-buildings.svg" alt=""
                           class="h-auto w-auto object-cover shrink-0">
                     </span>
                     <span class="text-20 font-medium">No lab visits needed</span>
                  </li>
                  <li class="flex items-center gap-2 sm:gap-4 onsite-ul-list">
                     <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-surface-strong">
                        <img src="~/Assets/images/products/bestfor/high-rise-buildings.svg" alt=""
                           class="h-auto w-auto object-cover shrink-0">
                     </span>
                     <span class="text-20 font-medium">Expert interpretation</span>
                  </li>
               </ul>
            </div>
         </div>
      </div>

      <div data-rail-scope class="mt-8 bg-surface pb-8 pt-8 sm:mt-10 sm:pb-16 sm:pt-16 lg:mt-10 lg:pb-24 lg:pt-20">
