@using Priya_Cement_MVC.Helpers
@using Priya_Cement_BusinessLogic.Entity
@model List<Priya_Cement_BusinessLogic.Entity.ArticleModel>
@functions {
   bool IsPressVideo(string input)
   {
      if (string.IsNullOrWhiteSpace(input)) return false;
      var value = input.Trim();
      var path = value.Split('?', '#')[0];
      if (path.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase)
         || path.EndsWith(".webm", StringComparison.OrdinalIgnoreCase)
         || path.EndsWith(".ogg", StringComparison.OrdinalIgnoreCase)
         || path.EndsWith(".ogv", StringComparison.OrdinalIgnoreCase)
         || path.EndsWith(".mov", StringComparison.OrdinalIgnoreCase))
      {
         return true;
      }
      return value.Contains("youtube.com", StringComparison.OrdinalIgnoreCase)
         || value.Contains("youtu.be", StringComparison.OrdinalIgnoreCase)
         || value.Contains("vimeo.com", StringComparison.OrdinalIgnoreCase);
   }

   string PressMediaSrc(ArticleModel item)
   {
      if (item == null) return string.Empty;
      foreach (var candidate in new[] { item.MediafilePath, item.ExternalUrl, item.Url })
      {
         if (IsPressVideo(candidate)) return candidate.Trim();
      }
      return item.ThumbnailImage ?? string.Empty;
   }
}




@foreach (var item in Model)
{
   if (!string.IsNullOrWhiteSpace(item.Content) || !string.IsNullOrWhiteSpace(item.ExternalUrl) ||
     (!string.IsNullOrWhiteSpace(item.MediafilePath) && item.MediafilePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)))
   {
      <article class="press-release-text-card">
         <time class="press-release-text-date" datetime="@item.DisplayDate">@item.DisplayDate?.ToString("MMMM dd, yyyy")</time>
         <h3 class="press-release-text-title">
            <a href="@item.Url"
               target="@(!string.IsNullOrWhiteSpace(item.ExternalUrl) || !string.IsNullOrWhiteSpace(item.MediafilePath) ? "_blank" : "_self")">
               @item.Title
            </a>
         </h3>
      </article>
   }
   else
   {
      var mediaSrc = PressMediaSrc(item);
      var isVideo = IsPressVideo(mediaSrc);
      <a class="image-gallery-card@(isVideo ? " is-video" : "")" href="@mediaSrc" data-gallery-src="@mediaSrc"
         data-gallery-title="@item.Title" data-gallery-date="@item.DisplayDate?.ToString("MMMM dd, yyyy")"
         aria-label="@item.ThumbnailAltText">
         <span class="image-gallery-frame">
            <img src="@item.ThumbnailImage" alt="@item.ThumbnailAltText" width="480" height="600" loading="lazy">
         </span>
         <div class="image-gallery-caption">
            <strong>@item.Title</strong>
            <span>@item.DisplayDate?.ToString("MMMM dd, yyyy")</span>
         </div>
      </a>
   }
}

