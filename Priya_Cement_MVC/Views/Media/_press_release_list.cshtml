@using Priya_Cement_MVC.Helpers
@model List<Priya_Cement_BusinessLogic.Entity.ArticleModel>


@foreach (var item in Model)
{
   <a class="image-gallery-card" href="@item.ThumbnailImage" aria-label="@item.ThumbnailAltText">
      <img src="@item.ThumbnailImage" alt="@item.ThumbnailAltText" width="480" height="600" loading="lazy">
      <div class="image-gallery-caption">
         <strong>@item.Title</strong>
         <span>@item.DisplayDate?.ToString("MMMM dd, yyyy")</span>
      </div>
   </a>
}

