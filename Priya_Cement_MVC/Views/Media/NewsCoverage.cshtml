@using Priya_Cement_MVC.Helpers
@model Priya_Cement_BusinessLogic.Entity.MediaModel
@{
   ViewData["Title"] = Model?.Content?.ContTitle ?? "News Coverage";
   Layout = "~/Views/Shared/_Layout.cshtml";
   var content = Model?.Content;
}

@section head {
   <title>@(content?.cont_window_title)</title>

   <meta content="@(content?.cont_metatag)" name="keywords" />
   <meta content="@(content?.cont_metadesc)" name="description" />

   <meta name="twitter:card" content="summary" />
   <meta name="twitter:site" content="" />
   <meta name="twitter:title" content="@(content?.ContTitle)" />
   <meta name="twitter:description" content="@(content?.cont_metadesc)" />

   <meta property="og:type" content="article" />
   <meta property="og:site_name" content="Priya Cement" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:url" content="@(content?.CanonicalUrl)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />

   <meta itemprop="name" content="Priya Cement" />
   <meta itemprop="description" content="@(content?.cont_metadesc)" />
   <meta itemprop="image" content="@(content?.cont_meta_image)" />

   <meta property="og:type" content="website" />
   <meta property="og:site_name" content="Priya Cement" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />
   <meta property="og:url" content="@(content?.CanonicalUrl)" />

   <link rel="canonical" href="@(content?.CanonicalUrl)" />
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/media-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/image-gallery.css" asp-append-version="true" />
}

<!-- HERO BANNER END-->
@if (Model?.Content != null)
{
   @await Html.PartialAsync("~/Views/CommonComponent/_page_banner.cshtml", Model.Content)
}
<!-- HERO BANNER END -->


@if (Model?.Print_List != null && Model.Print_List.Any())
{
   foreach (var item in Model.Print_List.Where(x => x.IsBlock == 0))
   {
      <section class="section-spacing print-section" aria-labelledby="print-heading">
         <div class="container">
            <div class="section-title-outer section-title-outer-start section-title-md section-title-left">
               <h2 class="text-h2 title-section reveal-text">
                  @Html.Raw(!string.IsNullOrWhiteSpace(item.DisplayTitle)
                              ? item.DisplayTitle.CleanParagraphTags()
                              : item.Title)
               </h2>

               @if (!string.IsNullOrWhiteSpace(item.Intro))
               {
                  <p>@Html.Raw(item.Intro.CleanParagraphTags())</p>
               }

            </div>

            <div class="image-gallery mt-5" data-gallery="print">
               @foreach (var item1 in Model.Print_List.Where(x => x.IsBlock == 1).OrderBy(x => x.Sequence))
               {
                  <a class="image-gallery-card" href="@item1.ThumbnailImage" aria-label="@item1.ThumbnailAltText">
                     <img src="@item1.ThumbnailImage" alt="@item1.ThumbnailAltText" width="480" height="600" loading="lazy">
                  </a>
               }
            </div>
         </div>
      </section>
   }
}


@if (Model?.Gallery_List != null && Model.Gallery_List.Any())
{
   foreach (var item in Model.Gallery_List.Where(x => x.IsBlock == 0))
   {
      <section class="section-spacing gallery-section relative overflow-hidden bgimage-section"
               aria-labelledby="gallery-heading">
         <div class="bgimage-outer-wrap" aria-hidden="true">
            <img src="~/Assets/images/bg-image.webp" alt="" class="w-full h-full object-cover bg-image">
         </div>
         <div class="container relative z-1">
            <div class="section-title-outer section-title-outer-start section-title-md section-title-left">
               <h2 id="gallery-heading" class="text-h2 title-section reveal-text">
                  @Html.Raw(!string.IsNullOrWhiteSpace(item.DisplayTitle)
                               ? item.DisplayTitle.CleanParagraphTags()
                               : item.Title)
               </h2>
               @if (!string.IsNullOrWhiteSpace(item.Intro))
               {
                  <p>@Html.Raw(item.Intro.CleanParagraphTags())</p>
               }
            </div>

            <div class="image-gallery image-gallery-4 mt-5" data-gallery="gallery">
               @foreach (var item1 in Model.Gallery_List.Where(x => x.IsBlock == 1).OrderBy(x => x.Sequence))
               {
                  <a class="image-gallery-card" href="@item1.ThumbnailImage" aria-label="@item1.ThumbnailAltText">
                     <img src="@item1.ThumbnailImage" alt="@item1.ThumbnailAltText" width="480" height="600" loading="lazy">
                  </a>
               }
            </div>
         </div>
      </section>
   }
}

   
@section Scripts {
   <script src="~/Assets/js/inner-banner-script.js" asp-append-version="true"></script>
   <script src="~/Assets/js/newscoverage-script.js" asp-append-version="true"></script>
   <script src="~/Assets/js/image-gallery.js" asp-append-version="true"></script>
}