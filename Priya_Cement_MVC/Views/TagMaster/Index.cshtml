@using Priya_Cement_BusinessLogic 
@model List_Model_Tags

@{
    Layout = "~/Views/Shared/Manage/_Layout_RHS.cshtml";
    ViewData["Title"] = "List Tags";
    string returnUrl = Context.Request.Query["ReturnUrl"].ToString();
}

<h2 class="mb-3">@ViewData["Title"]</h2>

@if (TempData["AlertMessage"] != null)
{
    <div class="alert alert-info">
        @TempData["AlertMessage"]
    </div>
}

<div class="mb-3">
    <a asp-action="AddTemplateMaster" class="btn btn-primary">
        Add New
    </a>
</div>

@using (Html.BeginForm("Index", "TagMaster", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    <div class="row align-items-end mb-3">
        <div class="col-md-3">
            <div class="form-group mb-3">
                <label for="ddLanguage" class="form-label">Language</label>
                @Html.DropDownListFor(model => model.language_id, Model.Languages ?? new List<SelectListItem>(), new { id = "ddLanguage", @class = "form-select" })
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group mb-3">
                <label for="ddStatus" class="form-label">Status</label>
                @Html.DropDownListFor(model => model.Status,
                    new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Active", Value = "1" },
                        new SelectListItem { Text = "Inactive", Value = "0" }
                    },
                    new { id = "ddStatus", @class = "form-select" })
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group mb-3">
                <button type="submit" class="btn btn-primary" name="Command" value="Search">Search</button>
            </div>
        </div>
    </div>
}

<table class="table table-bordered table-striped table-hover template-master-table">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tag Name</th>
            <th>Language Master</th>            
            <th>Status</th>
            <th>Created Date</th>
            <th>Updated Date</th>
            <th class="template-master-col-actions">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model.List_tags != null && Model.List_tags.Count > 0)
        {
            foreach (var item in Model.List_tags)
            {
                <tr>
                    <td>@item.ID</td>
                    <td>@item.Language_Master_ID</td>
                    <td>@item.Tag_Name</td>
                    <td>
                        @if (item.Status == 1)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>@item.Created_Date</td>
                    <td>@item.Updated_Date</td>

                    <td>
                        <div class="template-master-actions">
                            <a asp-action="EditTemplateMaster" asp-route-Id="@CryptoEngine.Encrypt(item.ID.ToString())" class="btn btn-sm btn-outline-secondary">Edit</a>

                            @if (item.Status == 1)
                            {
                                <a asp-action="Deactivate"
                                   asp-route-encId="@CryptoEngine.Encrypt(item.ID.ToString())"
                                   class="btn btn-sm btn-outline-danger js-deactivate-confirm"
                                   data-confirm-message="Are you sure you want to deactivate this template?">
                                    Deactivate
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted">
                    No templates found.
                </td>
            </tr>
        }
    </tbody>
</table>

@section head {
    <link rel="stylesheet" href="~/Assets/css/template-master-style.css" />
}

@section Scripts {
    <script src="~/Assets/scripts/template_master_index.js"></script>
}
