                    <div class="mt-8 flex flex-wrap sm:items-center sm:justify-center gap-x-[44px] gap-y-3">
                        <label class="radio-opt">
                            <input asp-for="ServiceTypeId" type="radio" value="1" />
                            <span class="radio-dot"></span>
                            <span class="text-p font-medium text-white">Schedule an testing visit</span>
                        </label>

                        <label class="radio-opt">
                            <input asp-for="ServiceTypeId" type="radio" value="2" />
                            <span class="radio-dot"></span>
                            <span class="text-p font-medium text-white">Request technical support for your
                                project</span>
                        </label>
                        <span asp-validation-for="ServiceTypeId" class="text-red-500"></span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mt-10">

                        <div>
                            <input asp-for="Name" class="f-field" placeholder="Name*" />
                            <span asp-validation-for="Name" class="text-red-500"></span>
                        </div>

                        <div>
                            <input asp-for="Designation" class="f-field" placeholder="Designation" />
                            <span asp-validation-for="Designation"></span>
                        </div>

                        <div>
                            <input asp-for="CompanyName" class="f-field" placeholder="Company or firm name*" />
                            <span asp-validation-for="CompanyName"></span>
                        </div>

                        <div>
                            <input asp-for="PhoneNumber" class="f-field" placeholder="Phone number*" />
                            <span asp-validation-for="PhoneNumber"></span>
                        </div>

                        <div>
                            <input asp-for="EmailAddress" class="f-field" placeholder="Email address*" />
                            <span asp-validation-for="EmailAddress"></span>
                        </div>

                        <div>
                            <select asp-for="StateId" class="f-field">
                                <option value="">Select State</option>
                                @foreach (var item in ViewBag.StateList)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                            <span asp-validation-for="StateId"></span>
                        </div>

                        <div>
                            <select asp-for="CityId" class="f-field">
                                <option value="">Site Location</option>
                                @foreach (var item in ViewBag.CityList)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                            <span asp-validation-for="CityId"></span>
                        </div>

                        <div>
                            <select asp-for="TestTypeId" class="f-field">
                                <option value="">Type of tests required</option>
                                @foreach (var item in ViewBag.TestTypeList)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                            <span asp-validation-for="TestTypeId"></span>
                        </div>

                    </div>

                    <div class="text-center mt-8">
                        <button type="submit" class="common-btn btn-slide-fill">
                            <span>Submit</span>
                            <img src="~/Assets/images/arrows/creamarrow-long-right.png" alt="">
                        </button>
                        <div id="technicalSupportMessage" class="mt-3"></div>
                    </div>

                </form>
            </div>
        </div>
    </div>
</section>
