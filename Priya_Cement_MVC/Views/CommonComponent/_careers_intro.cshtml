                            <linearGradient id="paint0_linear_careers_intro" x1="243.992" y1="0" x2="243.992" y2="447.44" gradientUnits="userSpaceOnUse">
                                <stop offset="0.223684" stop-color="#EBEBEB"/>
                                <stop offset="0.851754" stop-color="white"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(media))
            {
                <div class="careers-intro">
                    <img src="@media" alt="@mediaAlt" class="w-auto h-auto object-cover">
                </div>
            }
        </div>
    </section>
}
