@using Priya_Cement_BusinessLogic.Entity
@using Priya_Cement_MVC.Helpers
@model List<ComponentModel>

@{
    var intro = Model?.FirstOrDefault(x => x.IsBlock == 0) ?? Model?.FirstOrDefault();
    var title = !string.IsNullOrWhiteSpace(intro?.DisplayTitle) ? intro.DisplayTitle : intro?.Title;
    var body = !string.IsNullOrWhiteSpace(intro?.Intro) ? intro.Intro : intro?.Content;
    var media = !string.IsNullOrWhiteSpace(intro?.Component_right_image)
        ? intro.Component_right_image
        : (!string.IsNullOrWhiteSpace(intro?.ComponentThumbnail) ? intro.ComponentThumbnail : intro?.ThumbnailImage);
    var mediaAlt = !string.IsNullOrWhiteSpace(intro?.Component_Right_image_alt)
        ? intro.Component_Right_image_alt
        : intro?.ComponentThumbnailAltText;
}

@if (intro != null)
{
    <section class="relative overflow-hidden section-spacing page-intro-outer">
        <div class="container">
            <div class="section-title-outer section-title-outer-start section-title-large relative intro-outer-wrapper section-with-intro no-p-width">
                @if (!string.IsNullOrWhiteSpace(title))
                {
                    <h2 class="text-h2 title-section reveal-text">
                        @Html.Raw(title.CleanParagraphTags())
                    </h2>
                }
                @if (!string.IsNullOrWhiteSpace(body))
                {
                    <p>@Html.Raw(body.CleanParagraphTags())</p>
                }

                <div class="logo-lion-vector-outer lion-logo-wrap">
