@model SolutionCenterEnquiryModal


<form id="solutions-enquiry-form" novalidate
    class="mx-auto mt-10 grid max-w-[1248px] grid-cols-1 gap-x-[30px] lg:gap-x-[30px] xl:gap-x-[36px] gap-y-6 md:grid-cols-2 xl:grid-cols-3">
    <input type="text" name="fullName" placeholder="Full Name*" aria-label="Full Name" class="f-field" />
    <div class="f-field flex items-center gap-2 p-0">
        <span class="pl-1 text-[16px] font-light text-white">+91</span>
        <input type="tel" name="phone" placeholder="Phone Number*" aria-label="Phone Number"
            class="w-full bg-transparent text-base font-light text-white placeholder:text-white/40 focus:outline-none" />
    </div>
    <div class="f-field flex items-center gap-2 p-0">
        <span class="pl-1 text-[16px] font-light text-white">+91</span>
        <input type="tel" name="whatsapp" placeholder="WhatsApp Number*" aria-label="WhatsApp Number"
            class="w-full bg-transparent text-base font-light text-white placeholder:text-white/40 focus:outline-none" />
    </div>

    <input type="email" name="email" placeholder="Email Address*" aria-label="Email Address" class="f-field" />
    <div class="cselect" data-cselect data-name="gender" data-placeholder="Gender*"
        data-options="Male|Female|Other|Prefer not to say"></div>
    <div class="cselect" data-cselect data-name="ageGroup" data-placeholder="Age Group*"
        data-options="18-25|26-35|36-45|46-55|56+"></div>

    <div class="cselect" data-cselect data-name="district" data-placeholder="District*"
        data-options="Hyderabad|Rangareddy|Krishna|Visakhapatnam|Guntur|Chittoor|Other"></div>
    <input type="text" name="town" placeholder="Town / Village*" aria-label="Town / Village" class="f-field" />
    <div class="cselect" data-cselect data-name="occupation" data-placeholder="Current Occupation*"
        data-options="Business Owner|Dealer / Retailer|Civil Contractor|Professional|Homemaker|Student|Other">
    </div>

    <div class="solutions-enquiry-questions md:col-span-2 xl:col-span-3">
        <div class="solutions-enquiry-qpair">
            <div class="solutions-enquiry-q">
                <p class="solutions-enquiry-radio-label">Do you currently own a shop/commercial
                    space<span class="req">*</span></p>
                <div class="solutions-enquiry-radios" role="radiogroup"
                    aria-label="Do you currently own a shop or commercial space?">
                    <label class="radio-opt">
                        <input type="radio" name="ownsShop" value="yes" checked />
                        <span class="radio-dot" aria-hidden="true"></span>
                        <span class="text-p font-medium text-white">Yes</span>
                    </label>
                    <label class="radio-opt">
                        <input type="radio" name="ownsShop" value="no" />
                        <span class="radio-dot" aria-hidden="true"></span>
                        <span class="text-p font-medium text-white">No</span>
                    </label>
                </div>
            </div>
            <div class="solutions-enquiry-q">
                <p class="solutions-enquiry-radio-label">Have you previously run a business<span class="req">*</span>
                </p>
                <div class="solutions-enquiry-radios" role="radiogroup"
                    aria-label="Have you previously run a business?">
                    <label class="radio-opt">
                        <input type="radio" name="ranBusiness" value="yes" checked />
                        <span class="radio-dot" aria-hidden="true"></span>
                        <span class="text-p font-medium text-white">Yes</span>
                    </label>
                    <label class="radio-opt">
                        <input type="radio" name="ranBusiness" value="no" />
                        <span class="radio-dot" aria-hidden="true"></span>
                        <span class="text-p font-medium text-white">No</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="solutions-enquiry-qpair">
            <div class="solutions-enquiry-q">
                <p class="solutions-enquiry-radio-label">Do you have space for Store setup<span class="req">*</span></p>
                <div class="solutions-enquiry-radios" role="radiogroup" aria-label="Do you have space for store setup?">
                    <label class="radio-opt">
                        <input type="radio" name="hasStoreSpace" value="yes" checked />
                        <span class="radio-dot" aria-hidden="true"></span>
                        <span class="text-p font-medium text-white">Yes</span>
                    </label>
                    <label class="radio-opt">
                        <input type="radio" name="hasStoreSpace" value="no" />
                        <span class="radio-dot" aria-hidden="true"></span>
                        <span class="text-p font-medium text-white">No</span>
                    </label>
                </div>
            </div>
            <div class="solutions-enquiry-q solutions-enquiry-sqft" data-sqft-field>
                <p class="solutions-enquiry-radio-label">If Yes, what is the size in sq.ft.<span class="req">*</span>
                </p>
                <input type="text" name="sqft" placeholder="Sq. Ft." aria-label="Store size in square feet"
                    class="f-field" />
            </div>
        </div>
    </div>

    <div class="solutions-enquiry-preferred md:col-span-2 xl:col-span-3">
        <div class="cselect" data-cselect data-name="preferredTime" data-placeholder="Preferred Time for Contact"
            data-options="Morning (9 AM - 12 PM)|Afternoon (12 PM - 4 PM)|Evening (4 PM - 7 PM)|Anytime">
        </div>
    </div>

    <div class="md:col-span-2 xl:col-span-3 mt-3 flex justify-center">
        <button type="submit"
            class="inline-flex items-center gap-2.5 rounded-[10px] bg-white px-[14px] py-[10px] text-base font-medium text-[#231f20] shadow-[0px_4px_5px_rgba(0,0,0,0.1),0px_17px_8.5px_rgba(0,0,0,0.09)] transition-transform hover:-translate-y-0.5">
            Request a Call Back
            <svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
                <path d="M0 5h14M10 1l4 4-4 4" stroke="#231f20" stroke-width="1.4" stroke-linecap="round"
                    stroke-linejoin="round" />
            </svg>
        </button>
    </div>
</form>