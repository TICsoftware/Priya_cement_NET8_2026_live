@using Priya_Cement_MVC.Helpers
@model Priya_Cement_BusinessLogic.Entity.MediaModel
@{
   ViewData["Title"] = Model?.Content?.ContTitle ?? "Blogs";
   Layout = "~/Views/Shared/_Layout.cshtml";
   var content = Model?.Content;
}

@section head {
   <title>@(content?.cont_window_title)</title>

   <meta content="@(content?.cont_metatag)" name="keywords" />
   <meta content="@(content?.cont_metadesc)" name="description" />

   <meta name="twitter:card" content="summary" />
   <meta name="twitter:site" content="" />
   <meta name="twitter:title" content="@(content?.ContTitle)" />
   <meta name="twitter:description" content="@(content?.cont_metadesc)" />

   <meta property="og:type" content="article" />
   <meta property="og:site_name" content="Priya Cement" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:url" content="@(content?.CanonicalUrl)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />

   <meta itemprop="name" content="Priya Cement" />
   <meta itemprop="description" content="@(content?.cont_metadesc)" />
   <meta itemprop="image" content="@(content?.cont_meta_image)" />

   <meta property="og:type" content="website" />
   <meta property="og:site_name" content="Priya Cement" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />
   <meta property="og:url" content="@(content?.CanonicalUrl)" />

   <link rel="canonical" href="@(content?.CanonicalUrl)" />

 
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/media-style.css" asp-append-version="true" />
}

<!-- HERO BANNER END-->

@if (Model?.Content != null)
{
   @await Html.PartialAsync("~/Views/CommonComponent/_page_banner.cshtml", Model.Content)
}
<!-- HERO BANNER END -->


<section class="section-spacing fi-reports-section" aria-labelledby="fi-reports-heading">
   <div class="container">
      <div class="section-title-outer section-title-outer-start section-title-md section-title-left">
         <h2 class="text-h2 title-section reveal-text">
            @if (!string.IsNullOrWhiteSpace(Model.Content.Cont_hmpg_intro))
            {
               @Html.Raw(Model.Content.Cont_hmpg_intro.CleanParagraphTags())
            }
         </h2>
      </div>

      <div class="fi-card-grid fi-report-grid blogs-grid" id="blogsList">
         @foreach (var item in Model.SectionArticles_List)
         {
            <a class="fi-report-card blogs-card" href="@item.Url" aria-label="@item.Title">
               <span class="fi-report-cover blogs-cover">
                  <span class="fi-report-media blogs-media">
                     @* <img src="@(string.IsNullOrWhiteSpace(item.ThumbnailImage)
                          ? "/uploads/thumbnail/blogs_dummy.webp"
                          : item.ThumbnailImage)" alt="@item.ThumbnailAltText" width="480" height="600" loading="lazy"> *@
                     <img src="/uploads/thumbnail/blogs_dummy.webp" alt="@item.ThumbnailAltText" width="480" height="600" loading="lazy">
                  </span>
                  <span class="fi-report-copy blogs-copy">
                     <strong>@item.Title</strong>
                     <span>@item.DisplayDate?.ToString("MMMM dd, yyyy")</span>
                     <p>Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor.</p>
                  </span>
               </span>
            </a>
         }
      </div>

      @if (Model.TotalCount > 10)
      {
         <div class="text-center mt-4">
            <button type="button" id="loadMoreBtn" class="btn btn-primary" data-page="1" data-pagesize="10"
                    data-total="@Model.TotalCount" data-contid="@Model.Content.ContId">
               Load More
            </button>
         </div>
      }

   </div>
</section>

@section Scripts {
   <script src="~/Assets/js/inner-banner-script.js" asp-append-version="true"></script>
   <script src="~/Assets/js/pressreleases-script.js" asp-append-version="true"></script>
   <script src="~/scripts/blogs/Blogs.js" asp-append-version="true"></script>
}
