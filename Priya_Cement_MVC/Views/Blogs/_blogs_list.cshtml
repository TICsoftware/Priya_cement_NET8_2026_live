@using Priya_Cement_MVC.Helpers
@model List<Priya_Cement_BusinessLogic.Entity.ArticleModel>

@foreach (var item in Model)
{
   <a class="fi-report-card blogs-card" href="@item.MediafilePath" aria-label="@item.Title">

      <span class="fi-report-cover blogs-cover">

         <span class="fi-report-media blogs-media">
            <img src="@(string.IsNullOrWhiteSpace(item.ThumbnailImage) ? "/uploads/thumbnail/blogs_dummy.webp" : item.ThumbnailImage)" alt="@item.ThumbnailAltText" width="480" height="600" loading="lazy" />
         </span>

         <span class="fi-report-copy blogs-copy">
            <strong>@item.Title</strong>
            <span>@item.DisplayDate?.ToString("MMMM dd, yyyy")</span>
         </span>

      </span>
   </a>
}