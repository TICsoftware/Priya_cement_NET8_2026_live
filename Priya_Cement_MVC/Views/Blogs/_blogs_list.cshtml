@using Priya_Cement_MVC.Helpers
@model List<Priya_Cement_BusinessLogic.Entity.ArticleModel>

@foreach (var item in Model)
{
   <a class="fi-report-card" href="@item.MediafilePath" download aria-label="Download @item.Title">

      <span class="fi-report-cover">

         <span class="fi-report-media">
            <img src="@item.ThumbnailImage" alt="@item.ThumbnailAltText" width="420" height="560" loading="lazy">

            <span class="fi-report-dl" aria-hidden="true">
               <img src="~/Assets/images/common-images/download-vector-btn-white.svg" alt="" width="15" height="20">
            </span>
         </span>

         <span class="fi-report-copy">
            <strong>@item.Title</strong>
            <span>@item.DisplayDate?.ToString("MMMM dd, yyyy")</span>
         </span>

      </span>
   </a>
}