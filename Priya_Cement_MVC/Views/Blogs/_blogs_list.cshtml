@using Priya_Cement_MVC.Helpers
@model List<Priya_Cement_BusinessLogic.Entity.ArticleModel>

@foreach (var item in Model)
{
   <a class="fi-report-card" href="@item.MediafilePath" aria-label="@item.Title">

      <span class="fi-report-cover">

         <span class="fi-report-media">
            <img src="@(string.IsNullOrWhiteSpace(item.ThumbnailImage) ? "/uploads/thumbnail/annual_reports_dummy.png" : item.ThumbnailImage)" alt="@item.ThumbnailAltText" width="420" height="560" loading="lazy" />
         </span>

         <span class="fi-report-copy">
            <strong>@item.Title</strong>
            <span>@item.DisplayDate?.ToString("MMMM dd, yyyy")</span>
         </span>

      </span>
   </a>
}